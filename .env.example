# Copy this file to .env and fill it in. That is the whole setup.
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# .env is gitignored. Nothing else in this repo needs to be edited.
#
# The only real prerequisite is a subscription you can create resources in: if the
# resource group or the workspace named below do not exist, the notebook creates
# them. To point at an existing workspace instead, read the three values from the
# Azure ML Studio (top-right menu > "View all properties"), or run:
#   az ml workspace list -o table

# --- required -----------------------------------------------------------------

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=my-resource-group
AZUREML_WORKSPACE_NAME=my-aml-workspace

# Only used when the workspace has to be CREATED - ignored if it already exists.
# Pick a region where you have (or can get) low-priority NCasT4_v3 quota.
AZURE_LOCATION=westeurope

# --- optional -----------------------------------------------------------------

# Managed online endpoint names must be unique per region and subscription.
# Change this if "maint-vlm-ep" is already taken, or to run two demos side by side.
ENDPOINT_NAME=maint-vlm-ep

# Set to a small number (e.g. 40) for a ~3-minute smoke run that proves the
# plumbing without renting the GPU for long. 0 = the full 500-sample train split.
MAX_SAMPLES=0

# Escape hatch for the storage firewall repair in the setup cell. When the workspace
# storage comes out with public network access disabled (common on policy-managed
# tenants), the notebook allow-lists THIS MACHINE'S egress IP and nothing else. It
# finds that IP by calling api.ipify.org; if your proxy blocks that call, put the IP
# here instead. Leave empty otherwise.
# STORAGE_ALLOW_IP=

# Only used by scripts/61_vlm_dataset.ps1, the optional ADLS Gen2 variant of the
# dataset upload. The notebook does not need it: it uploads to workspaceblobstore.
# AZURE_STORAGE_ACCOUNT=
